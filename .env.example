# ============================================================================
# 🏥 Journal Club Bot (Rehab-Med EBM Edition) 환경변수 설정 파일 (.env.example)
# 💡 사용법: 이 파일을 '.env'로 복사한 뒤 본인의 API 키와 정보를 입력하세요.
# ============================================================================

# --- 📧 1. Email (SMTP) 알림 설정 ---
EMAIL=your_email@gmail.com
EMAIL_PASSWORD=your_16_digit_app_password
# 수신자가 여러 명일 경우 띄어쓰기 없이 콤마(,)로 구분하여 작성 (미입력 시 EMAIL 본인에게 발송)
# EMAIL_TO=professor@hospital.ac.kr,resident1@gmail.com,resident2@naver.com
# Gmail 외 타 메일 서버 사용 시 변경 (기본값: smtp.gmail.com / 465)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=465

# --- 🤖 2. Google Gemini AI 설정 ---
GEMINI_API_KEY=your_gemini_api_key_here
# 사용할 Gemini 모델 지정 (기본값: gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash

# --- 📚 3. Zotero 연동 설정 (중복 방지 Source of Truth & 서지 관리) ---
ZOTERO_USER_ID=your_zotero_user_id
ZOTERO_API_KEY=your_zotero_api_key
ZOTERO_LIBRARY_TYPE=user
# 봇이 스캔하고 업로드할 두 개의 Zotero 컬렉션(폴더) 고유 ID (8자리 영숫자)
ZOTERO_CANDIDATES_ID=your_candidates_collection_id
ZOTERO_PRESENTED_ID=your_presented_collection_id

# --- 📝 4. Notion 대시보드 연동 설정 ---
NOTION_API_KEY=ntn_your_notion_integration_token
NOTION_DATABASE_ID=your_notion_database_id

# --- 🔬 5. PubMed (NCBI Entrez) API 설정 ---
# 발급 시 초당 요청 제한이 3회 -> 10회로 대폭 완화됩니다 (선택 사항이지만 강력 권장)
NCBI_API_KEY=your_ncbi_api_key_here

# --- ⏰ 6. 스케줄러 및 고급 실행 설정 (선택 사항) ---
# SCHEDULE_DAILY_TIME=07:00
# SCHEDULE_WEEKLY_TIME=07:10
# SCHEDULE_MONTHLY_TIME=07:20
# MASS_SWEEP_DAYS=0
