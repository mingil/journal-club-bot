# ============================================================================
# 🏥 Medical Journal Club Bot (EBM Edition) - Environment Variables (.env.example)
# 💡 Usage: Copy this file to '.env' and fill in your actual API keys.
# ============================================================================

# --- 📧 1. Email (SMTP) Notification Settings ---
EMAIL=your_email@gmail.com
EMAIL_PASSWORD=your_16_digit_app_password
# Multiple recipients can be separated by commas without spaces (defaults to EMAIL if omitted)
# EMAIL_TO=professor@hospital.org,resident1@gmail.com,resident2@hospital.org
# Custom SMTP server settings (Default: smtp.gmail.com / 465)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=465

# --- 🤖 2. Google Gemini AI Settings ---
GEMINI_API_KEY=your_gemini_api_key_here
# Specify Gemini model name (Default: gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash

# --- 📚 3. Zotero Integration (Source of Truth for Deduplication) ---
ZOTERO_USER_ID=your_zotero_user_id
ZOTERO_API_KEY=your_zotero_api_key
ZOTERO_LIBRARY_TYPE=user
# Two 8-character Zotero Collection IDs tracked by the bot
ZOTERO_CANDIDATES_ID=your_candidates_collection_id
ZOTERO_PRESENTED_ID=your_presented_collection_id

# --- 📝 4. Notion Dashboard Integration ---
NOTION_API_KEY=ntn_your_notion_integration_token
NOTION_DATABASE_ID=your_notion_database_id

# --- 🔬 5. PubMed (NCBI Entrez) API Key ---
# Strongly recommended: Increases PubMed rate limit from 3 req/s to 10 req/s
NCBI_API_KEY=your_ncbi_api_key_here

# --- ⏰ 6. Scheduler & Advanced Options (Optional) ---
# SCHEDULE_DAILY_TIME=07:00
# SCHEDULE_WEEKLY_TIME=07:10
# SCHEDULE_MONTHLY_TIME=07:20
# MASS_SWEEP_DAYS=0

# (Optional) Telegram summary of new papers + fatal-error alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
